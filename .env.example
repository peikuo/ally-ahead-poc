# Node 24.22.2; local, disposable POC only. Copy to .env; never commit .env.
DATABASE_URL=postgresql://poc:poc-local-only@127.0.0.1:55432/ally_poc
PORT=3210
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3210
FILE_STORAGE_DIR=.data/files
# disabled: no provider traffic. live: explicitly configured Pi provider.
AGENT_MODE=disabled
AGENT_MODEL_CONFIG=config/model.json
AGENT_API_KEY=
# PayPal endpoints are hard-coded to Sandbox; empty values disable checkout.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set 43-128 base64url characters for /ops/consultations. Empty disables it.
TRACE_VIEWER_TOKEN=
SESSION_TTL_HOURS=24
